@model SistemaDeAgendamentos.Models.Agendamento

<h2>Editar Agendamento</h2>

<form asp-action="Edit">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label asp-for="Nome"></label>
        <input asp-for="Nome" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Servico"></label>
        <input asp-for="Servico" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="DataHora"></label>
        <input asp-for="DataHora" type="datetime-local" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Salvar Alterações</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
